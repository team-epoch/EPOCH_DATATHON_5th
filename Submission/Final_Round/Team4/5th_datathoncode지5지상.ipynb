&#x20;           min_child_weight=loguniform(1.0, 25.0),

&#x20;           colsample_bytree=uniform(0.5, 0.5), subsample=uniform(0.65, 0.35),

&#x20;           reg_lambda=loguniform(1.0, 60.0), weight_power=[0.0, 0.5, 1.0]),

