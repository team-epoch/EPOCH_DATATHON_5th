def local_candidate_grid(report, trials, seed):

&#x20;   """Keep prior CV leaders and perturb their neighborhoods reproducibly."""

&#x20;   rng = np.random.default_rng(seed)

&#x20;   grid = {}

&#x20;   for name, previous in report["selected_hyperparameters"].items():

&#x20;       ranked = sorted((row for row in report["tuning_results"] if row["model"] == name),

&#x20;                       key=score_key, reverse=True)

&#x20;       anchors = [dict(previous)]

&#x20;       for row in ranked:

&#x20;           if row["params"] not in anchors:

&#x20;               anchors.append(dict(row["params"]))

&#x20;           if len(anchors) == 3:

&#x20;               break

&#x20;       candidates = anchors[:trials]

&#x20;       seen = {json.dumps(p, sort_keys=True) for p in candidates}

&#x20;       attempts = 0

&#x20;       while len(candidates) < trials:

&#x20;           \# Mostly refine the winner, while retaining nearby alternative optima.

&#x20;           center = anchors[0 if attempts % 3 else (attempts // 3) % len(anchors)]

&#x20;           params = dict(center)

&#x20;           attempts += 1

&#x20;           adjustable = [key for key in params if key != "n_estimators" or name != "extra_trees"]

&#x20;           for key in rng.choice(adjustable, size=min(3, len(adjustable)), replace=False):

&#x20;               value = params[key]

&#x20;               if key == "weight_power":

&#x20;                   params[key] = float(rng.choice([0.0, 0.25, 0.5, 0.75, 1.0]))

&#x20;               elif key == "max_depth":

&#x20;                   params[key] = int(rng.choice([4, 6, 8, 12])) if value is None else int(np.clip(value + rng.choice([-1, 1]), 2, 24))

&#x20;               elif key in ("colsample_bytree", "subsample", "max_features"):

&#x20;                   params[key] = float(np.clip(value + rng.uniform(-0.12, 0.12), 0.25, 1.0))

&#x20;               elif key in ("n_estimators", "max_iter"):

&#x20;                   params[key] = int(np.clip(round(value \* rng.uniform(0.7, 1.35) / 25) \* 25, 75, 1000))

&#x20;               elif isinstance(value, int):

&#x20;                   params[key] = max(2, int(round(value \* rng.uniform(0.7, 1.3))))

&#x20;               elif isinstance(value, float):

&#x20;                   params[key] = float(value \* np.exp(rng.uniform(-0.4, 0.4)))

&#x20;           if name == "lightgbm":

&#x20;               params["num_leaves"] = min(params["num_leaves"], 2 \*\* params["max_depth"])

&#x20;           identity = json.dumps(params, sort_keys=True)

&#x20;           if identity not in seen:

&#x20;               candidates.append(params)

&#x20;               seen.add(identity)

&#x20;       grid[name] = candidates

&#x20;   return grid





def make_model(name, params, y, seed, jobs):

&#x20;   params = dict(params)

&#x20;   power = params.pop("weight_power", 1.0)

&#x20;   counts = np.bincount(np.asarray(y, dtype=int), minlength=2)

&#x20;   if counts.min() == 0:

&#x20;       raise ValueError("Each model's training subset must contain both classes.")

&#x20;   weight = float(counts[0] / counts[1]) \*\* power

&#x20;   if name == "lightgbm":

&#x20;       estimator = LGBMClassifier(

&#x20;           \*\*params, objective="binary", metric="average_precision",

&#x20;           scale_pos_weight=weight, subsample_freq=1, reg_alpha=0.1,

&#x20;           random_state=seed, n_jobs=jobs, verbosity=-1,

&#x20;           deterministic=True, force_col_wise=True,

&#x20;       )

&#x20;   elif name == "xgboost":

&#x20;       estimator = XGBClassifier(

&#x20;           \*\*params, objective="binary:logistic", eval_metric="aucpr",

&#x20;           tree_method="hist", scale_pos_weight=weight, reg_alpha=0.1,

&#x20;           random_state=seed, n_jobs=jobs, verbosity=0,

&#x20;       )

&#x20;   elif name == "extra_trees":

&#x20;       estimator = ExtraTreesClassifier(

&#x20;           \*\*params, class_weight="balanced", random_state=seed, n_jobs=jobs,

&#x20;       )

&#x20;   elif name == "hist_gradient_boosting":

&#x20;       estimator = HistGradientBoostingClassifier(

&#x20;           \*\*params, early_stopping=False, random_state=seed,

&#x20;       )

&#x20;   else:

&#x20;       raise ValueError(f"Unknown model family: {name}")

&#x20;   \# keep_empty_features preserves column count even for entirely missing folds.

&#x20;   return Pipeline([

&#x20;       ("imputer", SimpleImputer(strategy="median", add_indicator=True,

&#x20;                                 keep_empty_features=True)),

&#x20;       ("model", estimator),

&#x20;   ])





def fit_model(name, params, X, y, seed, jobs):

&#x20;   model = make_model(name, params, y, seed, jobs)

&#x20;   fit_args = {}

&#x20;   if name == "hist_gradient_boosting":

&#x20;       fit_args["model__sample_weight"] = compute_sample_weight("balanced", y)

&#x20;   \# Also bound OpenMP threads used by HistGradientBoosting.

&#x20;   with threadpool_limits(limits=jobs):

&#x20;       model.fit(X, y, \*\*fit_args)

&#x20;   return model





def predict(model, X, jobs):

&#x20;   with threadpool_limits(limits=jobs):

&#x20;       prediction = model.predict_proba(X)[:, 1]

&#x20;   if not np.isfinite(prediction).all():

&#x20;       raise ValueError("Model returned non-finite predictions.")

&#x20;   return prediction





def stratified_folds(y, seed):

&#x20;   counts = np.bincount(np.asarray(y, dtype=int), minlength=2)

&#x20;   if counts.min() < 5:

&#x20;       raise ValueError("5-fold OOF requires at least five training examples of each class.")

&#x20;   return list(StratifiedKFold(n_splits=5, shuffle=True, random_state=seed).split(

&#x20;       np.zeros(len(y)), y

&#x20;   ))





def oof_predictions(name, params, X, y, folds, seed, jobs):

&#x20;   oof = np.full(len(y), np.nan)

&#x20;   for fold, (train_index, holdout_index) in enumerate(folds, 1):

&#x20;       model = fit_model(name, params, X.iloc[train_index], y[train_index],

&#x20;                         seed + fold, jobs)

&#x20;       oof[holdout_index] = predict(model, X.iloc[holdout_index], jobs)

&#x20;   if not np.isfinite(oof).all():

&#x20;       raise ValueError("OOF predictions do not cover every training row.")

&#x20;   return oof





def tune_models(X, y, X_valid, y_valid, seed, jobs, trials=12, prior_report=None, checkpoint=None):

&#x20;   folds = stratified_folds(y, seed)

&#x20;   selected, oof_columns, validation_columns, tuning_rows, single_scores = {}, [], [], [], {}

&#x20;   grid = local_candidate_grid(prior_report, trials, seed) if prior_report else candidate_grid(trials, seed)

&#x20;   for name, candidates in grid.items():

&#x20;       best_result, best_params, best_oof = None, None, None

&#x20;       for number, params in enumerate(candidates, 1):

&#x20;           print(f"Training {name} candidate {number}/{len(candidates)} (5 folds)...", flush=True)

&#x20;           oof = oof_predictions(name, params, X, y, folds, seed, jobs)

&#x20;           \# Mean fold scores reduce the effect of probability-scale drift between folds.

&#x20;           fold_scores = [metrics(y[idx], oof[idx]) for \_, idx in folds]

&#x20;           result = {key: float(np.mean([row[key] for row in fold_scores]))

&#x20;                     for key in fold_scores[0]}

&#x20;           print_score(f"CV {name} #{number}", result)

&#x20;           tuning_rows.append({"model": name, "candidate": number, "params": params,

&#x20;                               "fold_scores": fold_scores, \*\*result})

&#x20;           if checkpoint is not None:

&#x20;               write_report(checkpoint, {"completed_candidates": tuning_rows})

&#x20;           if best_result is None or score_key(result) > score_key(best_result):

&#x20;               best_result, best_params, best_oof = result, params, oof

&#x20;       selected[name] = best_params

&#x20;       oof_columns.append(best_oof)

&#x20;       model = fit_model(name, best_params, X, y, seed, jobs)

&#x20;       val_prediction = predict(model, X_valid, jobs)

&#x20;       validation_columns.append(val_prediction)

&#x20;       single_scores[name] = metrics(y_valid, val_prediction)

&#x20;       print_score(f"VALID {name}", single_scores[name])

&#x20;   return (selected, np.column_stack(oof_columns), np.column_stack(validation_columns),

&#x20;           single_scores, tuning_rows)





def make_meta(C, seed):

&#x20;   return Pipeline([

&#x20;       ("scaler", StandardScaler()),

&#x20;       ("model", LogisticRegression(C=C, max_iter=2000, solver="lbfgs", random_state=seed)),

&#x20;   ])





def select_ensemble(y_train, oof, y_valid, valid_matrix, single_scores, seed):

&#x20;   weights = np.array([row["pr_auc_average_precision"] for row in single_scores.values()])

&#x20;   weights = weights / weights.sum() if weights.sum() else np.full(len(weights), 1 / len(weights))

&#x20;   ranked = np.column_stack([rank01(column) for column in valid_matrix.T])

&#x20;   predictions = {

&#x20;       "weighted_soft_voting": valid_matrix @ weights,

&#x20;       "rank_averaging": ranked.mean(axis=1),

&#x20;       "weighted_rank_averaging": ranked @ weights,

&#x20;   }

&#x20;   specs = {name: {"method": name} for name in predictions}

&#x20;   \# Optimize weights on training OOF only, not by thousands of holdout trials.

&#x20;   \# A coarse 10% grid, at least two families, and a 90% cap limit concentration.

&#x20;   names = list(single_scores)

&#x20;   for mode in ["probability", "rank"]:

&#x20;       train_matrix = oof if mode == "probability" else np.column_stack([rank01(c) for c in oof.T])

&#x20;       validation_matrix = valid_matrix if mode == "probability" else ranked

&#x20;       best_oof_score, best_weights = None, None

&#x20;       for counts in product(range(10), repeat=len(names) - 1):

&#x20;           remainder = 10 - sum(counts)

&#x20;           if not 0 <= remainder <= 9:

&#x20;               continue

&#x20;           candidate_weights = np.array([\*counts, remainder], dtype=float) / 10

&#x20;           if np.count_nonzero(candidate_weights) < 2:

&#x20;               continue

&#x20;           score = metrics(y_train, train_matrix @ candidate_weights)

&#x20;           if best_oof_score is None or score_key(score) > score_key(best_oof_score):

&#x20;               best_oof_score, best_weights = score, candidate_weights

&#x20;       name = f"oof_tuned\_{mode}\_blend"

&#x20;       predictions[name] = validation_matrix @ best_weights

&#x20;       specs[name] = {"method": "oof_tuned_blend", "mode": mode,

&#x20;                      "weights": dict(zip(names, best_weights.tolist())),

&#x20;                      "oof_selection_metrics": best_oof_score}

&#x20;   \# Meta-model labels come only from the outer training partition.

&#x20;   for C in [0.1, 1.0, 10.0]:

&#x20;       name = f"oof_stacking_C{C:g}"

&#x20;       meta = make_meta(C, seed)

&#x20;       meta.fit(oof, y_train)

&#x20;       predictions[name] = meta.predict_proba(valid_matrix)[:, 1]

&#x20;       specs[name] = {"method": "oof_stacking", "C": C}

&#x20;   scores = {name: metrics(y_valid, prediction) for name, prediction in predictions.items()}

&#x20;   for name, score in scores.items():

&#x20;       print_score(f"VALID {name}", score)

&#x20;   winner = max(scores, key=lambda name: score_key(scores[name]))

&#x20;   return winner, specs[winner], weights, scores, predictions





def final_prediction(selected, spec, weights, X, y, Xt, seed, jobs):

&#x20;   columns = []

&#x20;   final_oof = []

&#x20;   folds = stratified_folds(y, seed) if spec["method"] == "oof_stacking" else None

&#x20;   for name, params in selected.items():

&#x20;       print(f"Refitting {name} on all {len(y)} labeled rows...", flush=True)

&#x20;       if folds is not None:

&#x20;           final_oof.append(oof_predictions(name, params, X, y, folds, seed, jobs))

&#x20;       model = fit_model(name, params, X, y, seed, jobs)

&#x20;       columns.append(predict(model, Xt, jobs))

&#x20;   matrix = np.column_stack(columns)

&#x20;   method = spec["method"]

&#x20;   if method == "oof_tuned_blend":

&#x20;       if spec["mode"] == "rank":

&#x20;           matrix = np.column_stack([rank01(column) for column in matrix.T])

&#x20;       return matrix @ np.array([spec["weights"][name] for name in selected])

&#x20;   if method == "weighted_soft_voting":

&#x20;       return matrix @ weights

&#x20;   if method in ("rank_averaging", "weighted_rank_averaging"):

&#x20;       ranks = np.column_stack([rank01(column) for column in matrix.T])

&#x20;       return ranks.mean(axis=1) if method == "rank_averaging" else ranks @ weights

&#x20;   if method == "oof_stacking":

&#x20;       meta = make_meta(spec["C"], seed)

&#x20;       meta.fit(np.column_stack(final_oof), y)

&#x20;       return meta.predict_proba(matrix)[:, 1]

&#x20;   raise ValueError(f"Unknown ensemble strategy: {method}")





def validate_rows(rows, name, labeled=False):

&#x20;   if "row_id" not in rows or rows.empty or rows.row_id.isna().any() or not rows.row_id.is_unique:

&#x20;       raise ValueError(f"{name} must contain nonempty, unique row_id values.")

&#x20;   if labeled and ("target" not in rows or not rows.target.isin([0, 1]).all()):

&#x20;       raise ValueError("train_labels.csv target values must be 0 or 1.")

&#x20;   keys = make_keys(rows)

&#x20;   if keys.cutoff.isna().any() or keys.channel_id.eq("").any():

&#x20;       raise ValueError(f"{name} row_id must have channel_id_YYYY-MM-DD format.")

&#x20;   return keys





def write_report(path, report):

&#x20;   path.write_text(json.dumps(report, ensure_ascii=False, indent=2, allow_nan=False), encoding="utf-8")





