def read_csv_any(root: Path, name: str) -> pd.DataFrame:

&#x20;   p = root / name

&#x20;   if not p.exists():

&#x20;       p = root / ALIASES.get(name, name)

&#x20;   if not p.exists():

&#x20;       raise FileNotFoundError(f"Missing {name} or alias {ALIASES.get(name)} in {root}")

&#x20;   return pd.read_csv(p)





def safe_div(a, b):

&#x20;   return a / (np.abs(b) + 1.0)





def make_keys(rows: pd.DataFrame) -> pd.DataFrame:

&#x20;   parts = rows.row_id.astype(str).str.rsplit("\_", n=1, expand=True)

&#x20;   return pd.DataFrame({"channel_id": parts[0], "cutoff": pd.to_datetime(parts[1])})





def build_features(rows: pd.DataFrame, snap: pd.DataFrame, vid: pd.DataFrame, v5: pd.DataFrame):

&#x20;   keys = make_keys(rows)



&#x20;   snap = snap.copy()

&#x20;   vid = vid.copy()

&#x20;   v5 = v5.copy()



&#x20;   snap["collected_at"] = pd.to_datetime(snap["collected_at"])

&#x20;   vid["published_at"] = pd.to_datetime(vid["published_at"])

&#x20;   v5["published_at"] = pd.to_datetime(v5["published_at"])



&#x20;   for frame, columns in [(snap, ["subscriber_count", "total_view_count", "video_count"]),

&#x20;                          (vid, ["duration_sec", "is_shorts"]),

&#x20;                          (v5, ["view_5d", "like_5d", "comment_5d", "is_shorts"])]:

&#x20;       for column in columns:

&#x20;           if column in frame:

&#x20;               frame[column] = pd.to_numeric(frame[column], errors="coerce")



&#x20;   \# h_after is interpreted as hours since publication.

&#x20;   hours = pd.to_numeric(v5.get("h_after", pd.Series(120, index=v5.index)), errors="coerce").fillna(120).clip(lower=120)

&#x20;   v5["available_at"] = v5["published_at"] + pd.to_timedelta(hours, unit="h")



&#x20;   sg = {k: g.sort_values("collected_at") for k, g in snap.groupby("channel_id", sort=False)}

&#x20;   vg = {k: g.sort_values("published_at") for k, g in vid.groupby("channel_id", sort=False)}

&#x20;   fg = {k: g.sort_values("available_at") for k, g in v5.groupby("channel_id", sort=False)}



&#x20;   records = []

&#x20;   empty_snap = snap.iloc[:0]

&#x20;   empty_vid = vid.iloc[:0]

&#x20;   empty_v5 = v5.iloc[:0]



&#x20;   for row_number, (channel, cut) in enumerate(keys.itertuples(index=False, name=None), 1):

&#x20;       if row_number == 1 or row_number % 100 == 0:

&#x20;           print(f"  Features: {row_number}/{len(keys)}", flush=True)

&#x20;       f = {}



&#x20;       s = sg.get(channel, empty_snap)

&#x20;       s = s[s.collected_at < cut]

&#x20;       f["snapshot_n"] = len(s)

&#x20;       f["snapshot_age_days"] = (cut - s.collected_at.iloc[-1]).total_seconds() / 86400 if len(s) else np.nan



&#x20;       for col in ["subscriber_count", "total_view_count", "video_count"]:

&#x20;           latest = s[col].iloc[-1] if len(s) and col in s else np.nan

&#x20;           f[col] = latest

&#x20;           f[f"log1p\_{col}"] = np.log1p(max(latest, 0)) if pd.notna(latest) else np.nan



&#x20;           for days in [1, 3, 5, 7, 14, 21, 28, 56]:

&#x20;               old = s[s.collected_at <= cut - pd.Timedelta(days=days)] if len(s) else s

&#x20;               prev = old[col].iloc[-1] if len(old) and col in old else np.nan

&#x20;               delta = latest - prev if pd.notna(latest) and pd.notna(prev) else np.nan

&#x20;               f[f"{col}\_delta\_{days}"] = delta

&#x20;               f[f"{col}\_growth\_{days}"] = safe_div(delta, prev) if pd.notna(delta) else np.nan

&#x20;               elapsed = (

&#x20;                   (s.collected_at.iloc[-1] - old.collected_at.iloc[-1]).total_seconds() / 86400

&#x20;                   if len(s) and len(old)

&#x20;                   else np.nan

&#x20;               )

&#x20;               f[f"{col}\_daily_delta\_{days}"] = delta / elapsed if pd.notna(delta) and pd.notna(elapsed) and elapsed > 0 else np.nan



&#x20;       \# Compare observed daily slopes in adjacent seven-day windows.

&#x20;       for col in ["subscriber_count", "total_view_count", "video_count"]:

&#x20;           week = s[s.collected_at <= cut - pd.Timedelta(days=7)]

&#x20;           fortnight = s[s.collected_at <= cut - pd.Timedelta(days=14)]

&#x20;           previous_daily = np.nan

&#x20;           previous_growth = np.nan

&#x20;           if len(week) and len(fortnight) and col in s:

&#x20;               elapsed = (week.collected_at.iloc[-1] - fortnight.collected_at.iloc[-1]).total_seconds() / 86400

&#x20;               delta = week[col].iloc[-1] - fortnight[col].iloc[-1]

&#x20;               previous_daily = delta / elapsed if elapsed > 0 else np.nan

&#x20;               previous_growth = safe_div(delta, fortnight[col].iloc[-1])

&#x20;           f[f"{col}\_previous_7d_daily_delta"] = previous_daily

&#x20;           f[f"{col}\_growth_acceleration_7d"] = f[f"{col}\_daily_delta_7"] - previous_daily

&#x20;           f[f"{col}\_growth_rate_acceleration_7d"] = f[f"{col}\_growth_7"] - previous_growth



&#x20;       \# Cross ratios that often help ranking growth channels.

&#x20;       f["views_per_subscriber_now"] = safe_div(f.get("total_view_count", np.nan), f.get("subscriber_count", np.nan))

&#x20;       f["videos_per_subscriber_now"] = safe_div(f.get("video_count", np.nan), f.get("subscriber_count", np.nan))

&#x20;       f["views_per_video_now"] = safe_div(f.get("total_view_count", np.nan), f.get("video_count", np.nan))

&#x20;       for d in [7, 14, 28]:

&#x20;           f[f"sub_delta_per_video_delta\_{d}"] = safe_div(f.get(f"subscriber_count_delta\_{d}", np.nan), f.get(f"video_count_delta\_{d}", np.nan))

&#x20;           f[f"view_delta_per_sub_delta\_{d}"] = safe_div(f.get(f"total_view_count_delta\_{d}", np.nan), f.get(f"subscriber_count_delta\_{d}", np.nan))



&#x20;       v = vg.get(channel, empty_vid)

&#x20;       v = v[v.published_at < cut]

&#x20;       f["video_history_n"] = len(v)

&#x20;       f["last_upload_age"] = (cut - v.published_at.max()).total_seconds() / 86400 if len(v) else np.nan



&#x20;       for days in [3, 7, 14, 28, 56]:

&#x20;           q = v[v.published_at >= cut - pd.Timedelta(days=days)] if len(v) else v

&#x20;           f[f"uploads\_{days}"] = len(q)

&#x20;           if len(q):

&#x20;               f[f"shorts_fraction\_{days}"] = pd.to_numeric(q.get("is_shorts", pd.Series(index=q.index)), errors="coerce").mean()

&#x20;               f[f"duration_median\_{days}"] = pd.to_numeric(q.get("duration_sec", pd.Series(index=q.index)), errors="coerce").median()

&#x20;               f[f"duration_mean\_{days}"] = pd.to_numeric(q.get("duration_sec", pd.Series(index=q.index)), errors="coerce").mean()

&#x20;           else:

&#x20;               f[f"shorts_fraction\_{days}"] = np.nan

&#x20;               f[f"duration_median\_{days}"] = np.nan

&#x20;               f[f"duration_mean\_{days}"] = np.nan



&#x20;       previous_uploads = f["uploads_14"] - f["uploads_7"]

&#x20;       f["uploads_previous_7"] = previous_uploads

&#x20;       f["upload_frequency_ratio_7d"] = (f["uploads_7"] + 1) / (previous_uploads + 1)

&#x20;       f["upload_frequency_acceleration_7d"] = (f["uploads_7"] - previous_uploads) / 7.0

&#x20;       for typ, value in [("short", 1), ("long", 0)]:

&#x20;           recent_videos = v[v.published_at >= cut - pd.Timedelta(days=28)]

&#x20;           subset = recent_videos[pd.to_numeric(recent_videos.get("is_shorts", pd.Series(index=recent_videos.index, dtype=float)), errors="coerce").eq(value)]

&#x20;           duration = pd.to_numeric(subset.get("duration_sec", pd.Series(index=subset.index, dtype=float)), errors="coerce")

&#x20;           f[f"{typ}\_duration_median_28d"] = duration.median()

&#x20;           f[f"{typ}\_duration_mean_28d"] = duration.mean()



&#x20;       z = fg.get(channel, empty_v5)

&#x20;       z = z[z.available_at < cut]

&#x20;       f["v5_history_n"] = len(z)



&#x20;       for lo, hi in [(0, 7), (7, 14), (0, 14), (14, 28), (0, 28), (28, 56), (0, 56)]:

&#x20;           q = z[(z.published_at >= cut - pd.Timedelta(days=hi)) & (z.published_at < cut - pd.Timedelta(days=lo))] if len(z) else z

&#x20;           for typ in ["all", "long", "short"]:

&#x20;               if typ == "all":

&#x20;                   a = q

&#x20;               else:

&#x20;                   want_short = int(typ == "short")

&#x20;                   a = q[pd.to_numeric(q.get("is_shorts", pd.Series(index=q.index)), errors="coerce").eq(want_short)] if len(q) else q



&#x20;               prefix = f"v5\_{lo}\_{hi}\_{typ}"

&#x20;               f[prefix + "\_n"] = len(a)

&#x20;               for col in ["view_5d", "like_5d", "comment_5d"]:

&#x20;                   vals = pd.to_numeric(a[col], errors="coerce") if len(a) and col in a else pd.Series(dtype=float)

&#x20;                   f[f"{prefix}\_{col}\_median"] = vals.median()

&#x20;                   f[f"{prefix}\_{col}\_mean"] = vals.mean()

&#x20;                   f[f"{prefix}\_{col}\_max"] = vals.max()

&#x20;                   f[f"{prefix}\_{col}\_std"] = vals.std()

&#x20;                   f[f"{prefix}\_{col}\_sum"] = vals.sum() if len(vals) else np.nan

&#x20;                   f[f"{prefix}\_{col}\_p75"] = vals.quantile(0.75) if len(vals) else np.nan

&#x20;               view = pd.to_numeric(a["view_5d"], errors="coerce") if len(a) and "view_5d" in a else pd.Series(dtype=float)

&#x20;               like = pd.to_numeric(a["like_5d"], errors="coerce") if len(a) and "like_5d" in a else pd.Series(dtype=float)

&#x20;               comment = pd.to_numeric(a["comment_5d"], errors="coerce") if len(a) and "comment_5d" in a else pd.Series(dtype=float)

&#x20;               f[prefix + "\_like_rate"] = (like / (view + 1)).median() if len(a) else np.nan

&#x20;               f[prefix + "\_comment_rate"] = (comment / (view + 1)).median() if len(a) else np.nan



&#x20;       for typ in ["all", "long", "short"]:

&#x20;           recent = f.get(f"v5_0_14\_{typ}\_view_5d_median", np.nan)

&#x20;           prev = f.get(f"v5_14_28\_{typ}\_view_5d_median", np.nan)

&#x20;           f[f"{typ}\_view_momentum_14_28"] = safe_div(recent - prev, prev) if pd.notna(recent) and pd.notna(prev) else np.nan

&#x20;           f[f"{typ}\_views_per_subscriber"] = safe_div(recent, f.get("subscriber_count", np.nan)) if pd.notna(recent) else np.nan



&#x20;       for col in ["view_5d", "like_5d", "comment_5d"]:

&#x20;           short = f[f"v5_0_28_short\_{col}\_median"]

&#x20;           long = f[f"v5_0_28_long\_{col}\_median"]

&#x20;           f[f"short_long\_{col}\_ratio_28d"] = safe_div(short, long)

&#x20;       for typ in ["all", "long", "short"]:

&#x20;           recent = f[f"v5_0_7\_{typ}\_view_5d_median"]

&#x20;           previous = f[f"v5_7_14\_{typ}\_view_5d_median"]

&#x20;           f[f"{typ}\_view_momentum_7_14"] = safe_div(recent - previous, previous)

&#x20;       \# Retention requires measured watch-time data; duration alone is not retention.

&#x20;       if "average_view_duration_sec" in z and "duration_sec" in z:

&#x20;           for typ, value in [("short", 1), ("long", 0)]:

&#x20;               observed = z[z.published_at >= cut - pd.Timedelta(days=28)]

&#x20;               observed = observed[pd.to_numeric(observed["is_shorts"], errors="coerce").eq(value)]

&#x20;               duration = pd.to_numeric(observed["duration_sec"], errors="coerce")

&#x20;               watched = pd.to_numeric(observed["average_view_duration_sec"], errors="coerce")

&#x20;               ratio = watched / duration.where(duration > 0)

&#x20;               f[f"{typ}\_watch_duration_ratio_28d"] = ratio.median()

&#x20;       records.append(f)



&#x20;   X = pd.DataFrame(records).replace([np.inf, -np.inf], np.nan)

&#x20;   return X, keys





def metrics(y, prediction):

&#x20;   prediction = np.asarray(prediction, dtype=float)

&#x20;   if prediction.shape != (len(y),) or not np.isfinite(prediction).all():

&#x20;       raise ValueError("Predictions must be a finite vector matching the labels.")

&#x20;   return {

&#x20;       "pr_auc_average_precision": float(average_precision_score(y, prediction)),

&#x20;       "roc_auc": float(roc_auc_score(y, prediction)),

&#x20;   }





def score_key(result):

&#x20;   \# AP is primary; ROC-AUC breaks ties rather than competing with the objective.

&#x20;   return result["pr_auc_average_precision"], result["roc_auc"]





def print_score(name, result):

&#x20;   print(f"{name:42s} PR-AUC(AP)={result['pr_auc_average_precision']:.6f} "

&#x20;         f"ROC-AUC={result['roc_auc']:.6f}", flush=True)





def rank01(prediction):

&#x20;   prediction = np.asarray(prediction)

&#x20;   if len(prediction) <= 1:

&#x20;       return np.full(len(prediction), 0.5)

&#x20;   return (rankdata(prediction, method="average") - 1.0) / (len(prediction) - 1.0)





